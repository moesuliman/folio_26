---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { withBase } from '../../lib/base-url';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjectCover } from '../../lib/project-cover';

const projects = (await getCollection('projects'))
	.filter((project) => project.data.category === 'brand' && !project.data.hidden)
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Brand" description="Brand design projects.">
	<Nav slot="nav" />

	<section class="hero">
		<p class="hero__label"><a href={withBase('/work')}>Work</a> / Brand</p>
		<h1>Brand</h1>
	</section>

	<ul class="project-grid">
		{
			projects.map((project) => {
				const { cover, coverVideo } = getProjectCover(project);

				return (
					<ProjectCard
						href={`/work/${project.id}`}
						title={project.data.title}
						cover={cover}
						coverVideo={coverVideo}
						coverBg={project.data.coverBg}
						category={project.data.category}
						tags={project.data.tags}
					/>
				);
			})
		}
	</ul>

	<Footer slot="footer" />
</BaseLayout>
