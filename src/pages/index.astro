---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getLatestListenLabel } from '../lib/listenbrainz';
import { withBase } from '../lib/base-url';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.hidden)
	.sort((a, b) => a.data.order - b.data.order);

// Latest listen from ListenBrainz at build time (see LISTENBRAINZ_USERNAME).
const latestListen = await getLatestListenLabel();
---

<BaseLayout flush description="Selected product, brand, and art work by Moe Suliman.">
	<Nav slot="nav" />

	<section class="hero hero--intro site-measure">
		<a class="hero__logo" href={withBase('/')} aria-label="Moe Suliman home">
			<img src={withBase('/logo_w.png')} alt="" width="160" height="107" />
		</a>
		<h1>Mohamed Suliman</h1>
		<div class="hero__bio">
			<p>
				I design product and brand for early-stage startups and small independent businesses, usually
				ones with something real that isn't all the way there yet. Twelve years in, the balance is
				different every time, so I go where the business goes furthest. I like to work directly with
				founders to get there.
			</p>
			<p>
				<strong class="hero__bio-current">Currently</strong>
				Founding Designer at <a href="https://kydlabs.com">KYD Labs</a>, building the brand and
				software venues use to run &amp; market live events.
			</p>
		</div>
		<div class="hero__meta">
			<div class="hero__meta-col">
				<p>moe@moesuliman.com</p>
				<p class="hero__meta-socials">
					<a href="https://www.linkedin.com/in/moe-suliman">Linkedin</a>
					<span class="hero__meta-sep" aria-hidden="true">·</span>
					<a href="https://instagram.com/halal.harami">Instagram</a>
					<span class="hero__meta-sep" aria-hidden="true">·</span>
					<a href="https://x.com/mo__786">X</a>
				</p>
			</div>
			<div class="hero__meta-col">
				<p><span class="hero__glyph" aria-hidden="true">⌂</span> Brooklyn, NY</p>
				<p><span class="hero__glyph" aria-hidden="true">♪</span> {latestListen}</p>
			</div>
		</div>
	</section>

	<section class="work-board">
		<div class="site-measure">
			<div class="filters filters--heading" role="group" aria-label="Filter by category">
				<button type="button" data-filter="all" aria-pressed="true">All Work</button>
				<button type="button" data-filter="product" aria-pressed="false">Product</button>
				<button type="button" data-filter="brand" aria-pressed="false">Brand</button>
				<button type="button" data-filter="art" aria-pressed="false">Art</button>
			</div>
		</div>

		<ul class="project-grid project-grid--bleed">
			{
				projects.map((project) => (
					<ProjectCard
						href={`/work/${project.id}`}
						title={project.data.title}
						cover={project.data.cover}
						coverBg={project.data.coverBg}
						category={project.data.category}
						tags={project.data.tags}
					/>
				))
			}
		</ul>
	</section>

	<Footer slot="footer" />
</BaseLayout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const items = document.querySelectorAll<HTMLElement>('.work-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter ?? 'all';

			buttons.forEach((other) => {
				other.setAttribute('aria-pressed', String(other === button));
			});

			items.forEach((item) => {
				const category = item.dataset.category;
				item.hidden = filter !== 'all' && category !== filter;
			});
		});
	});
</script>
