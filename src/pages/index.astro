---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectCover } from '../lib/project-cover';
import { getLatestListen, getListenKicker } from '../lib/listenbrainz';
import { withBase } from '../lib/base-url';
import { formatEasternTime } from '../lib/eastern-time';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.hidden)
	.sort((a, b) => a.data.order - b.data.order);

// Latest listen from ListenBrainz at build time (see LISTENBRAINZ_USERNAME).
const latestListen = await getLatestListen();
---

<BaseLayout
	flush
	description="Selected product, brand, and art work by Moe Suliman."
	preconnect={['https://api.listenbrainz.org', 'https://musicbrainz.org', 'https://coverartarchive.org', 'https://archive.org']}
>
	<Nav slot="nav" />

	<section class="hero hero--intro site-measure">
		<a class="hero__logo" href={withBase('/')} aria-label="Moe Suliman home">
			<img src={withBase('/logo_w.png')} alt="" width="160" height="107" />
		</a>
		<h1>Mohamed Suliman</h1>
		<div class="hero__bio">
			<p>
				I design product and brand for early-stage startups and small independent businesses, usually
				ones with something real that isn't all the way there yet. Twelve years in, the balance is
				different every time, so I go where the business goes furthest. I work directly with
				founders to get there.
			</p>
			<p>
				<strong class="hero__bio-current">Currently</strong>
				Founding Designer at <a href="https://kydlabs.com">KYD Labs</a>, building the brand and
				software venues use to run &amp; market live events.
			</p>
		</div>
		<div class="hero__meta">
			<div class="hero__meta-col">
				<p>moe@moesuliman.com</p>
				<p class="hero__meta-socials">
					<a href="https://www.linkedin.com/in/moe-suliman">Linkedin</a>
					<span class="hero__meta-sep" aria-hidden="true">·</span>
					<a href="https://instagram.com/halal.harami">Instagram</a>
					<span class="hero__meta-sep" aria-hidden="true">·</span>
					<a href="https://x.com/mo__786">X</a>
				</p>
			</div>
			<div class="hero__meta-col">
				<p class="hero__location">
					<span class="hero__glyph" aria-hidden="true">⌂</span>
					<span class="hero__location-text">
						Brooklyn, NY
						<time class="hero__local-time" datetime={new Date().toISOString()}>
							{formatEasternTime()}
						</time>
					</span>
				</p>
				<div
					class="hero__listen-wrap"
					data-listenbrainz-user={import.meta.env.LISTENBRAINZ_USERNAME}
					data-fallback-label="Chanel Beads"
					data-initial-art-url={latestListen.artUrl ?? undefined}
					data-initial-status={latestListen.status}
				>
					<button
						type="button"
						class="hero__listen-trigger"
						aria-expanded="false"
						aria-controls="hero-listen-popover"
						aria-haspopup="dialog"
					>
						{
							latestListen.artUrl ? (
								<span
									class="hero__glyph hero__listen-glyph hero__listen-glyph--art"
									aria-hidden="true"
								>
									<span class="hero__listen-glyph-fallback">♪</span>
									<img
										class="hero__listen-art"
										src={latestListen.artUrl}
										data-art-src={latestListen.artUrl}
										alt=""
										width={16}
										height={16}
										decoding="async"
										fetchpriority="low"
									/>
								</span>
							) : (
								<span class="hero__glyph hero__listen-glyph" aria-hidden="true">
									♪
								</span>
							)
						}
						<span class="hero__listen-label">{latestListen.label}</span>
					</button>
					<div
						id="hero-listen-popover"
						class="hero__listen-popover"
						role="dialog"
						aria-label={getListenKicker(latestListen.status)}
						hidden
					>
						<a
							class="hero__listen-card"
							href={latestListen.href ?? 'https://listenbrainz.org'}
							target="_blank"
							rel="noopener noreferrer"
						>
							{
								latestListen.artUrl ? (
									<div class="hero__listen-card-art-wrap hero__listen-popover-item">
										<img
											class="hero__listen-card-art"
											src={latestListen.artUrl}
											data-art-src={latestListen.artUrl}
											alt=""
											loading="lazy"
											decoding="async"
										/>
									</div>
								) : (
									<div
										class="hero__listen-card-art-wrap hero__listen-card-art-wrap--fallback hero__listen-popover-item"
										aria-hidden="true"
									>
										<span class="hero__listen-card-art hero__listen-card-art--fallback">
											♪
										</span>
									</div>
								)
							}
							<span class="hero__listen-card-body">
								<span
									class="hero__listen-card-kicker hero__listen-popover-item"
									data-status={latestListen.status}
								>
									<span class="hero__listen-kicker-content">
										{
											latestListen.status === 'playing' && (
												<span class="hero__listen-kicker-glyph" aria-hidden="true">
													♪
												</span>
											)
										}
										{getListenKicker(latestListen.status)}
									</span>
								</span>
								<span class="hero__listen-card-track hero__listen-popover-item">
									{latestListen.track ?? latestListen.label}
								</span>
								<span
									class="hero__listen-card-artist hero__listen-popover-item"
									hidden={!latestListen.artist}
								>
									{latestListen.artist}
								</span>
								<span
									class="hero__listen-card-album hero__listen-popover-item"
									hidden={!latestListen.album}
								>
									{latestListen.album}
								</span>
							</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="work-board">
		<div class="work-board__tabs">
			<div class="site-measure">
				<div class="filters filters--heading" role="group" aria-label="Filter by category">
					<button type="button" data-filter="all" aria-pressed="true"><span>All Work</span></button>
					<button type="button" data-filter="product" aria-pressed="false"><span>Product</span></button>
					<button type="button" data-filter="brand" aria-pressed="false"><span>Brand</span></button>
					<button type="button" data-filter="art" aria-pressed="false"><span>Art</span></button>
				</div>
			</div>
		</div>

		<ul class="project-grid project-grid--bleed">
			{
				projects.map((project) => {
					const { cover, coverVideo } = getProjectCover(project);

					return (
						<ProjectCard
							href={`/work/${project.id}`}
							title={project.data.title}
							cover={cover}
							coverVideo={coverVideo}
							coverBg={project.data.coverBg}
							category={project.data.category}
							tags={project.data.tags}
						/>
					);
				})
			}
		</ul>
	</section>

	<Footer slot="footer" />
</BaseLayout>

<script>
	import '../scripts/latest-listen';
	import '../scripts/local-time';

	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const items = document.querySelectorAll<HTMLElement>('.work-item');

	buttons.forEach((button) => {
		button.addEventListener('click', () => {
			const filter = button.dataset.filter ?? 'all';

			buttons.forEach((other) => {
				other.setAttribute('aria-pressed', String(other === button));
			});

			items.forEach((item) => {
				const category = item.dataset.category;
				item.hidden = filter !== 'all' && category !== filter;
			});
		});
	});
</script>
