---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import {
	capitalizeCategory,
	getOtherProjects,
	getRelatedProjects,
	relatedProjectsHeading,
} from '../lib/related-projects';
import { withBase } from '../lib/base-url';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const projects = await getCollection('projects');
const related = getRelatedProjects(project, projects);
const other = getOtherProjects(project, projects, related);
const heading = relatedProjectsHeading(project, related);
---

{
	(related.length > 0 || other.length > 0) && (
		<section class="related-projects" aria-label="More projects">
			{
				related.length > 0 && (
					<>
						<h2 id="related-projects-heading" class="related-projects__title">
							{heading}
						</h2>
						<ul class="project-grid related-projects__grid">
							{related.map((item) => (
								<ProjectCard
									href={`/work/${item.id}`}
									title={item.data.title}
									cover={item.data.cover}
									coverBg={item.data.coverBg}
									category={item.data.category}
									tags={item.data.tags}
									still
									titleTag="h3"
								/>
							))}
						</ul>
					</>
				)
			}
			{
				other.length > 0 && (
					<div class="related-projects__other">
						<h2 class="related-projects__title">Other work</h2>
						<ul class="related-projects__list">
							{other.map((item) => (
								<li>
									<a href={withBase(`/work/${item.id}`)}>
										<span class="related-projects__list-title">{item.data.title}</span>
										<span class="related-projects__list-meta">
											{capitalizeCategory(item.data.category)}
											<span aria-hidden="true"> · </span>
											{item.data.year}
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
		</section>
	)
}
