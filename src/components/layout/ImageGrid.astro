---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	images: ImageMetadata[];
	columns?: 2 | 3 | 4;
}

const { images, columns = 2 } = Astro.props;
---

{
	images.length > 0 && (
		<div class={`image-grid image-grid--cols-${columns}`}>
			{images.map((image, index) => (
				<figure>
					<Image
						src={image}
						alt=""
						widths={[480, 768, 1200]}
						sizes={`(max-width: 720px) 100vw, ${Math.floor(100 / columns)}vw`}
						loading={index < 2 ? 'eager' : 'lazy'}
					/>
				</figure>
			))}
		</div>
	)
}
