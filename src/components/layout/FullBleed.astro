---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt?: string;
}

const { image, alt = '' } = Astro.props;
---

<figure class="full-bleed">
	<Image src={image} alt={alt} widths={[960, 1440, 1920]} sizes="100vw" loading="lazy" />
</figure>
