---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	href: string;
	title: string;
	summary: string;
	cover: ImageMetadata;
	category: string;
	year: number;
}

const { href, title, summary, cover, category, year } = Astro.props;
---

<li class="project-card work-item" data-category={category}>
	<a href={href}>
		<div class="project-card__media">
			<Image src={cover} alt="" widths={[480, 800]} sizes="(max-width: 720px) 100vw, 33vw" loading="lazy" />
		</div>
		<p class="project-card__meta">
			<span>{category}</span>
			<span>{year}</span>
		</p>
		<h2 class="project-card__title">{title}</h2>
		<p class="muted">{summary}</p>
	</a>
</li>
