---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImageGrid from '../components/layout/ImageGrid.astro';
import VideoBlock from '../components/layout/VideoBlock.astro';
import TextBlock from '../components/layout/TextBlock.astro';
import TwoCol from '../components/layout/TwoCol.astro';
import ThreeCol from '../components/layout/ThreeCol.astro';
import FullBleed from '../components/layout/FullBleed.astro';
import SemiFull from '../components/layout/SemiFull.astro';
import Stack from '../components/layout/Stack.astro';
import Section from '../components/layout/Section.astro';
import { getProjectImages } from '../lib/project-images';
import { displayTags } from '../lib/project-tags';

interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasCustomBody = Boolean(project.body?.trim());
const galleryImages = getProjectImages(project.data.category, project.id).filter(
	(image) => !/\/cover\.[^/]+$/i.test(image.src),
);
const tags = displayTags(project.data.tags);
---

<BaseLayout
	title={project.data.title}
	description={project.data.summary}
	flush
	bodyClass="page-project"
>
	<Nav slot="nav" />

	<article>
		<header class="project-header">
			<div class="project-header__bar">
				<a class="project-back" href="/">← Projects</a>
				<a class="project-logo" href="/" aria-label="Moe Suliman home">
					<img src="/logo_w.png" alt="" width="160" height="107" />
				</a>
			</div>
			<p class="project-header__meta">
				{tags.map((tag) => <span>{tag}</span>)}
				<span>{project.data.year}</span>
				{project.data.client && <span>{project.data.client}</span>}
				{project.data.role && <span>{project.data.role}</span>}
			</p>
			<h1>{project.data.title}</h1>
			{
				project.data.summary
					.split(/\n\n+/)
					.map((paragraph) => <p class="hero__lede">{paragraph}</p>)
			}
		</header>

		<div class="project-body">
			{
				hasCustomBody ? (
					<Content
						components={{
							ImageGrid,
							VideoBlock,
							TextBlock,
							TwoCol,
							ThreeCol,
							FullBleed,
							SemiFull,
							Stack,
							Section,
						}}
					/>
				) : (
					<>
						<FullBleed image={project.data.cover} alt={project.data.title} />
						<TextBlock>
							<p>{project.data.summary}</p>
						</TextBlock>
						{galleryImages.length > 0 && <ImageGrid images={galleryImages} columns={2} />}
					</>
				)
			}
		</div>
	</article>

	<Footer slot="footer" />
</BaseLayout>
